{
  "expo": {
    "name": "Seafarers Toolkit",
    "slug": "seafarer-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seafarerstoolkit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.seafarer.toolkit",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0254B6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allows taking photos of your documents for offline scanning.",
          "photosPermission": "Allows choosing document photos from your gallery."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "a-l-mahdi",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7a7eaa8-c716-4b08-8547-41f47df796fe"
      }
    }
  }
}
